#!/usr/bin/env python3
# TEST-ONLY stand-in for libsecret's `secret-tool` (lookup/store/clear subset) for boxes without libsecret-tools.
# Talks to the real Secret Service (e.g. a throwaway gnome-keyring-daemon in a dbus-run-session) via the
# `secretstorage` Python package. Secrets only via stdin/stdout. Exit 1 + empty stderr = not found (like secret-tool).
import sys
try:
    import secretstorage
except ImportError:
    sys.stderr.write('secretstorage missing\n'); sys.exit(127)
def attrs(a):
    if len(a) % 2: sys.stderr.write('bad attributes\n'); sys.exit(2)
    return dict(zip(a[0::2], a[1::2]))
cmd, rest = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ('', [])
try:
    conn = secretstorage.dbus_init()
    col = secretstorage.get_default_collection(conn)
    if col.is_locked(): col.unlock()
except Exception as e:
    sys.stderr.write('Secret Service not reachable\n'); sys.exit(1)
if cmd == 'lookup':
    items = list(col.search_items(attrs(rest)))
    if not items: sys.exit(1)
    sys.stdout.write(items[0].get_secret().decode('utf-8')); sys.exit(0)
if cmd == 'store':
    label = 'secret'
    if rest and rest[0].startswith('--label='): label, rest = rest[0][8:], rest[1:]
    col.create_item(label, attrs(rest), sys.stdin.buffer.read(), replace=True); sys.exit(0)
if cmd == 'clear':
    for it in col.search_items(attrs(rest)): it.delete()
    sys.exit(0)
sys.stderr.write('usage\n'); sys.exit(2)
